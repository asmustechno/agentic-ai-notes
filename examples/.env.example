# Copy this file to .env and fill in what you need:
#   cp .env.example .env
# .env is ignored by git. Never commit real keys.

# Which model provider the examples use: mock | anthropic | openai
#   mock      offline and free, returns scripted replies (the default)
#   anthropic needs ANTHROPIC_API_KEY  (https://platform.claude.com/)
#   openai    needs OPENAI_API_KEY and OPENAI_MODEL  (https://platform.openai.com/)
LLM_PROVIDER=mock

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5.
ANTHROPIC_MODEL=
# Optional reasoning effort: low | medium | high | xhigh | max (model default if empty)
ANTHROPIC_EFFORT=
# Server-side refusal fallback is on for models that support it. Set to "off" to disable.
ANTHROPIC_FALLBACKS=on

# --- OpenAI ---
OPENAI_API_KEY=
# Required for OpenAI: a current model ID from https://platform.openai.com/docs/models
OPENAI_MODEL=
