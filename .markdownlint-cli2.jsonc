// markdownlint configuration (used locally by markdownlint-cli2 and in CI).
{
  "config": {
    "default": true,
    "MD013": false,                          // line length: prose is not wrapped
    "MD033": false,                          // inline HTML: needed for <details> and <img>
    "MD041": false,                          // first line is the breadcrumb, not a heading
    "MD024": { "siblings_only": true },      // same heading text is fine in different sections
    "MD036": false,                          // italic diagram captions are not headings
    "MD060": false                           // table column alignment: generated tables are not padded
  },
  "ignores": [
    ".venv/**",
    "**/.venv/**",
    "site/**",
    "node_modules/**",
    "LICENSE",
    "CODE_OF_CONDUCT.md",
    ".github/ISSUE_TEMPLATE/**"
  ]
}
